opam-version: "2.0"
synopsis: "Cyrus Omar's webpage"
maintainer: ["Cyrus Omar <comar@umich.edu>"]
authors: ["Cyrus Omar <comar@umich.edu>"]
license: "ISC"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.21"}
  "bytesrw"
  "cmarkit"
  "cmdliner"
  "eio"
  "eio_main"
  "ezjsonm"
  "fmt"
  "fpath"
  "htmlit"
  "jsonfeed"
  "jsont"
  "logs"
  "mtime"
  "progress"
  "ptime"
  "re"
  "sitemap"
  "syndic"
  "tiny_httpd"
  "uri"
  "uutf"
  "xdg"
]
build: ["dune" "build" "-p" name "-j" jobs]
